// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(100)
  username  String      @unique @db.VarChar(100)
  password  String      @db.VarChar(100)
  email     String      @unique @db.VarChar(100)
  isActive  Boolean
  userRoles User_role[]

  @@map("mUsers")
}

model User_role {
  id Int @id @default(autoincrement())

  usersId Int? @db.Integer
  roleId  Int? @db.Integer

  users Users? @relation(fields: [usersId], references: [id])
  role  Role?  @relation(fields: [roleId], references: [id])

  @@map("userRole")
}

model Role {
  id          Int    @id @default(autoincrement())
  roleName    String @db.VarChar(35)
  roleCode    String @unique @db.Char(6)
  description String @db.VarChar(200)

  userRoles      User_role[]
  rolePermission Role_permission[]

  @@map("mRole")
}

model Role_permission {
  id     Int   @id @default(autoincrement())
  roleId Int?  @db.Integer
  role   Role? @relation(fields: [roleId], references: [id])

  @@map("rolePermission")
}

model Module {
  id         Int     @id @default(autoincrement())
  moduleName String  @db.VarChar(100)
  parentId   Int?    @db.Integer
  path       String  @db.VarChar(225)
  sortOrder  Int     @db.Integer
  isActive   Boolean

  modulePermission Module_permission[]

  @@map("mModule")
}

model Permission {
  id             Int    @id @default(autoincrement())
  permission     String @unique @db.VarChar(30)
  permissionCode String @db.VarChar(30)
  description    String @db.VarChar(225)

  modulePermission Module_permission[]

  @@map("mPermission")
}

model Module_permission {
  id           Int  @id @default(autoincrement())
  permissionId Int?
  moduleId     Int?

  permission Permission? @relation(fields: [permissionId], references: [id])
  module     Module?     @relation(fields: [moduleId], references: [id])

  @@map("modulePermission")
}
